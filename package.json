{
  "name": "datashare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "start:coverage": "ng run datashare:serve-coverage --port 4201",
    "cypress:run:coverage": "cypress run --config baseUrl=http://localhost:4201",
    "cypress:coverage": "start-server-and-test start:coverage http://localhost:4201 cypress:run:coverage",
    "precypress:coverage": "node -e \"require('node:fs').rmSync('coverage/.nyc-cypress/out.json', { force: true })\""
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "~21.2.25",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@babel/core": "^7.29.13",
    "@cypress/code-coverage": "^4.1.3",
    "@types/jest": "^30.0.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.1",
    "cypress": "^16.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "start-server-and-test": "^2.1.5",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.2",
    "zone.js": "^0.16.3"
  }
}
