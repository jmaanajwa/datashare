{
  "version": 1,
  "projects": {
    "datashare": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.scss"
            ],
            "outputPath": "dist/datashare"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "datashare:build"
          }
        },
        "build-coverage": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "customWebpackConfig": {
              "path": "webpack.coverage.cjs"
            },
            "outputPath": "dist/datashare-coverage",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          }
        },
        "serve-coverage": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "buildTarget": "datashare:build-coverage",
            "port": 4200
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d6a663cd-7cfb-40aa-bb63-d000f8fe9ba5"
  }
}
